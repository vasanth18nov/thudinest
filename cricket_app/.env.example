# Copy to .env and fill in from Firebase console → Project settings → General → Your apps → Web app.
# These values identify your Firebase project; they are not secrets (security comes from
# firestore.rules), but keep .env out of git so each environment can point at its own project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Path the app is served under. Must match the folder it is deployed to on thudinest.com.
VITE_BASE_PATH=/crickethub/

# Public origin, used to build shareable links (invites, public pages).
VITE_PUBLIC_ORIGIN=https://thudinest.com

# Optional: queue emails through the "Trigger Email from Firestore" Firebase extension.
# Leave false unless the extension is installed (see README → Email notifications).
VITE_ENABLE_EMAIL=false

# Development only: talk to the local Firebase emulators instead of a real project.
VITE_USE_EMULATORS=false
