# Loaded by `vite --mode emulator` (npm run dev:demo). Uses a demo-* project id, which the
# Firebase emulators accept without any real project or credentials. Safe to commit.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-crickethub
VITE_FIREBASE_APP_ID=demo-app
VITE_PUBLIC_ORIGIN=http://localhost:5173
VITE_USE_EMULATORS=true
