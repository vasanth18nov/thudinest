# OS files
.DS_Store
Thumbs.db

# Large media (keep only web-optimised images)
*.mp4
*.mov
*.MOV
*.MP4
*.m4a
*.webm
*.dmg
*.zip

# Exception: compressed hero/events loops for the Maya site (under 2 MB each)
!mayarestaurants/assets/video/*.mp4

# Wrangler local build cache
worker/.wrangler/

# Alisons Construction raw source photos (originals carry GPS EXIF);
# the site uses the stripped, resized copies in AlisonsConstruction/assets/img
AlisonsConstruction/images/

# Kavin page raw source photos/videos (iPhone originals carry GPS EXIF);
# the page uses the stripped, resized copies in kavin/img and kavin/media
kavin/*.jpg
kavin/*.mp4
!kavin/media/*.mp4
